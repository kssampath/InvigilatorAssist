# Rendered at container start by the nginx image's envsubst step (only variables set in the environment are
# replaced, so nginx's own $uri etc. are untouched). API_UPSTREAM is host:port of the Spring Boot API:
#   Kubernetes:      invigilator-api:8080   (the ClusterIP Service)
#   docker compose:  api:8080
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Same-origin API: the browser calls /api/... on this host, nginx forwards to the API Service. No CORS needed.
    location ~ ^/(api|swagger-ui|v3/api-docs)(/|$|\.html) {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 120s;
        client_max_body_size 10m;
    }

    # Probe endpoint for Kubernetes: answers without touching the API.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build assets can be cached for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths fall back to index.html for React Router.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
