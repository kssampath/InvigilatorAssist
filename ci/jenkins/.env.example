# Copy to .env (git-ignored) and fill in. scripts/azure-provision.sh fills the ACR_* lines for you.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_URL=http://localhost:8081/
JENKINS_PORT=8081

# Azure Container Registry (az acr credential show -n <acr>)
ACR_LOGIN_SERVER=
ACR_USERNAME=
ACR_PASSWORD=

# GitHub account + fine-grained token with "Contents: Read and write" on this repository
GITHUB_USER=
GITHUB_TOKEN=
GIT_REPO_URL=https://github.com/kssampath/InvigilatorAssist.git
GIT_BRANCH=master

# Public URL of the deployed app (web LoadBalancer), e.g. http://20.40.60.80. Optional: enables the
# pipeline's "Verify deployment" stage.
APP_URL=
